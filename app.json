{
  "expo": {
    "name": "Agenda",
    "slug": "agenda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "agenda"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.drruvari.agenda"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBFAF7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.drruvari.agenda",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFAF7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-font",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Agenda to show and add events from your calendars.",
          "remindersPermission": "Allow Agenda to access your reminders.",
          "writeOnlyCalendarPermission": "Allow Agenda to add events to your calendars."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Agenda to show birthdays from your contacts."
        }
      ],
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "36d7d621-e48a-4234-a9b2-aa8c79beda03"
      }
    }
  }
}
